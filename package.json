{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.16.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 0.0.0.0 --port ${PORT:-8444}",
    "dev:server": "node server/index.js",
    "stop:local": "pkill -f 'node server/index.js' || true; pkill -f 'vite --host 0.0.0.0' || true",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-8444}",
    "format": "oxfmt",
    "start": "node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
